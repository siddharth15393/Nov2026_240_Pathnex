3. Kubernetes:
   - Deployment with 3 replicas
   - Image: nginx

#=====================================================================================
	Day 21 Kubernetes
#=====================================================================================

apiVersion: apps/v1
kind: Deployment
metadata: 
  name: nginx-app
spec:
  replicas: 3
  selector: 
     matchLabels:
     	app: nginx-app
  template:
    metadata:
    	labels:
	   app: nginx-app
    spec:
      containers: 
        - name: nginx
	  image: nginx:latest
	  ports:
	    - containerPort: 80
