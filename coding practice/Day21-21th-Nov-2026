- name: Install start and enable nginx
  hosts: all
  become: yes
  
  tasks: 
    - name: Install nginx
      yum: 
       - name: nginx
         state: present

    - name: Start and enable SERVICE
      service:
        - name: nginx
	  state: started
	  enabled: yes
